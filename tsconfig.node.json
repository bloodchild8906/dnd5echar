{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "esModuleInterop": true,
    "target": "ESNext"
  },
  "include": ["vite.config.ts"],
  "exclude": ["node_modules"],
  "ts-node": {
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "allowSyntheticDefaultImports": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "inlineSourceMap": true,
      "inlineSources": true,
      "target": "ESNext",
      "noEmit": true,
      "esModuleInterop": true,
      "types": [
        "node"
      ]
    },
    "transpileOnly": true,
    "files": true,
    
    
  }
}
