# Codex Arcanum environment example
#
# When Supabase is configured below, the app will attempt to use Supabase as
# the primary persistence layer and keep localStorage as the fallback cache.

VITE_APP_NAME="Codex Arcanum"
VITE_APP_ENV="development"
VITE_DEFAULT_OPEN5E_DOCUMENT="5esrd"

# Optional but recommended for Supabase-primary persistence
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
